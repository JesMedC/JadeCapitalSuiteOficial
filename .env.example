# =====================================================
#  Jade Capital Suite — Variables de entorno
#  NO commitear el archivo .env real. Copiar de este.
# =====================================================

# --- Postgres ---
POSTGRES_DB=jadecapital
POSTGRES_USER=jade
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# --- MinIO / S3 ---
MINIO_ROOT_USER=jade-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
STORAGE_BUCKET=jade-uploads

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGIN=http://localhost:4200

# --- JWT ---
# Generar con: openssl rand -base64 48
# Mínimo 32 chars. Access y Refresh DEBEN ser distintos.
JWT_ISSUER=JadeCapitalSuite
JWT_AUDIENCE=JadeCapitalSuite.Client
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_access_token_secret_min_32_chars_xxxxxxxxxxxxxx
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_token_secret_min_32_chars_xxxxxxxxxx
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14

# --- Stripe (test keys) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME