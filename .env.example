# =====================================================
#  Jade Capital Suite — Variables de entorno
#  NO commitear el archivo .env real. Copiar de este.
# =====================================================

# --- Postgres ---
POSTGRES_DB=jadecapital
POSTGRES_USER=jade
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# --- MinIO / S3 ---
MINIO_ROOT_USER=jade-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
STORAGE_BUCKET=jade-uploads

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGIN=http://localhost:4200

# --- Frontend observability (public values embedded at build time) ---
FRONTEND_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
SENTRY_RELEASE=jade-capital-web@REPLACE_WITH_RELEASE
APP_ENV=production
# Emergency rollback only: permits an empty FRONTEND_SENTRY_DSN.
ALLOW_FRONTEND_SENTRY_DISABLED=false
# Build-only source-map upload metadata. Pass SENTRY_AUTH_TOKEN as a BuildKit
# secret (`--secret id=sentry_auth_token,env=SENTRY_AUTH_TOKEN`), never as ARG.
SENTRY_ORG=REPLACE_WITH_ORG_SLUG
SENTRY_PROJECT=REPLACE_WITH_PROJECT_SLUG
SENTRY_AUTH_TOKEN=SET_IN_CI_SECRET_STORE_ONLY

# --- JWT ---
# Generar con: openssl rand -base64 48
# Mínimo 32 chars. Access y Refresh DEBEN ser distintos.
JWT_ISSUER=JadeCapitalSuite
JWT_AUDIENCE=JadeCapitalSuite.Client
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_access_token_secret_min_32_chars_xxxxxxxxxxxxxx
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_token_secret_min_32_chars_xxxxxxxxxx
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14

# --- Stripe (test keys) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Mail (SMTP) — slice 0c ---
# Por defecto, local dev apunta al servicio "mailpit" del compose (puerto 1025,
# sin auth, sin STARTTLS). Para produccion reemplazar por la URL/credenciales
# del relay SMTP real.
MAIL__HOST=mailpit
MAIL__PORT=1025
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__FROM=no-reply@jadecapital.test
MAIL__USE_START_TLS=false
