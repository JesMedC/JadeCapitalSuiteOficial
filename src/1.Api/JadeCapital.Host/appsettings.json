{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuditRetention": {
    "RetentionDays": 90,
    "CleanupIntervalHours": 24,
    "BatchLimit": 10000,
    "InitialDelaySeconds": 120
  },
  "Sentry": {
    "Dsn": ""
  }
}
