<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1603;NU1605;CA1707;CA1848;CA1014;CA1716;CA1812;CA2007;CA1000;CA1861;CA1859;CA1725;CA1873;CA1305;CA1862;CA1806;MSB9008</NoWarn>
    <OutputType>Library</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RootNamespace>JadeCapital.Identity.Api</RootNamespace>
    <AssemblyName>JadeCapital.Identity.Api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JadeCapital.Identity.Application\JadeCapital.Identity.Application.csproj" />
    <ProjectReference Include="..\JadeCapital.Identity.Domain\JadeCapital.Identity.Domain.csproj" />
  </ItemGroup>
</Project>