# Wave 10 slice 10.2 — production Dockerfile for the Angular frontend.
#
# Stages:
#   1. `build` — node:20-alpine installs deps (npm ci) and runs the Angular
#      production build. Output lands in dist/jade-capital/browser (Angular
#      19 esbuild bundler default).
#   2. `runtime` — nginx:1.27-alpine serves the static bundle. Health is
#      probed with `wget` against /health (a tiny static response the
#      frontend nginx.conf maps to 200).
#
# Security:
#   * No build artefacts are committed to the image besides the dist/.
#   * No secrets baked in (CSP nonce injection happens at the nginx edge
#     in slice 10.3; nothing in this image is sensitive).
#   * USER is left at the nginx default; if you want explicit non-root,
#     substitute `nginxinc/nginx-unprivileged:1.27-alpine` here. The dev
#     image runs as `nginx`, and the prod-only nginx config enforces
#     a non-root worker via `user nginx;` in nginx.conf.

# =============================================================
# Stage 1 — Angular production build
# =============================================================
FROM node:20-alpine AS build
WORKDIR /app

# Lockfile-driven install (npm ci fails the build if package-lock.json is
# out of sync with package.json — keeps prod reproducible).
COPY frontend/package.json      frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Build with explicit production configuration (matches angular.json's
# `production` block: hashing, budgets, optimization on).
COPY frontend/ ./
RUN npm run build -- --configuration production

# =============================================================
# Stage 2 — nginx runtime
# =============================================================
FROM nginx:1.27-alpine AS runtime

# dist/jade-capital/browser is the Angular 19 esbuild output.
COPY --from=build /app/dist/jade-capital/browser/ /usr/share/nginx/html/
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ >/dev/null 2>&1 || exit 1

EXPOSE 80

# Keep nginx in the foreground so the container doesn't exit.
# Explicit (rather than inherited) so future maintainers can see the
# serve command at a glance.
CMD ["nginx", "-g", "daemon off;"]
