<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1902;NU1903;NU1603;NU1605;CA1707;CA1848;CA1014;CA1716;CA1812;CA2007;CA1000;CA1861;CA1859;CA1725;CA1873;CA1305;CA1862;CA1806;CS0618;ASPDEPR;MSB9008</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);$(WarningsNotAsErrors)</NoWarn>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>