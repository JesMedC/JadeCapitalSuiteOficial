<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JadeCapital.Admin.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Wave 9 slice 9b.1 — SQLite in-memory for AuditEventQueryStore integration
         tests. Mirrors the Wave 6 6d.2 SQLite pattern used in Identity.UnitTests.
         SQLite lets the test exercise EF-level behavior (cursor pagination +
         ExecuteDeleteAsync) without a real Postgres or Testcontainers dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <!-- Wave 9 slice 9b.1 — TestServer + TestAuthHandler for the AdminAuditEndpoints
         integration test (role matrix: 401/403/200). Uses an in-memory TestAuthHandler
         that injects role claims via the X-Test-Role header so the test does not
         need real Postgres for the 401/403 paths or Testcontainers for the 200 path. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <!-- Wave 10 slice 10.6 — test coverage gate (coverlet). -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\2.Modules\Admin\JadeCapital.Admin.Application\JadeCapital.Admin.Application.csproj" />
    <ProjectReference Include="..\..\..\src\2.Modules\Admin\JadeCapital.Admin.Infrastructure\JadeCapital.Admin.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\2.Modules\Admin\JadeCapital.Admin.Api\JadeCapital.Admin.Api.csproj" />
    <ProjectReference Include="..\..\..\src\2.Modules\Identity\JadeCapital.Identity.Infrastructure\JadeCapital.Identity.Infrastructure.csproj" />
  </ItemGroup>
</Project>
